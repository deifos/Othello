# Copy to .env.production.local, or set these values in your website host.
# These addresses are public. Use your own PartyKit project, not the demo service.

# Host printed by PartyKit deployment, such as my-game.my-account.partykit.dev.
VITE_PARTYKIT_HOST=

# Empty for a website hosted by PartyKit or the Node server with its own /api.
# For Vercel, use https://YOUR-HOST/parties/practice/global (no /api suffix).
# Set ALLOWED_ORIGIN on PartyKit to your exact Vercel/custom origin and redeploy.
VITE_LEADERBOARD_URL=
