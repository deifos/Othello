{
  "name": "flip-buddies",
  "private": true,
  "version": "0.1.0",
  "description": "A friendly Othello game with animated pill characters, CPU play, and online friend rooms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deifos/Othello.git"
  },
  "bugs": {
    "url": "https://github.com/deifos/Othello/issues"
  },
  "homepage": "https://github.com/deifos/Othello#readme",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,rankings,rooms \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\" \"partykit dev --no-hotkeys\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --dir tests",
    "dev:multiplayer": "partykit dev --no-hotkeys",
    "deploy:multiplayer": "partykit deploy --serve dist",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "types:cloudflare": "wrangler types cloudflare/worker-configuration.d.ts",
    "check:cloudflare": "npm run types:cloudflare && tsc -p tsconfig.cloudflare.json",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && npm run check:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.5",
    "@fontsource/nunito": "^5.2.7",
    "lucide-react": "^0.468.0",
    "partysocket": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "uisfx": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "partykit": "^0.0.115",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "partykit": {
      "esbuild": "^0.25.12"
    },
    "undici": "^6.28.0"
  }
}
