{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flip-buddies",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "flipbuddies.vladpalacio.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/parties/*"]
  },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "GameRoom" },
    { "name": "PRACTICE", "class_name": "PracticeBoard" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "PracticeBoard"] }],
  "observability": { "enabled": true }
}
