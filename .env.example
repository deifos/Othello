# Local development works with both values empty.
# Copy this file to .env.local to override local settings.
# VITE_ values are public and are included in the browser build. Never use secrets.

# Ranking service base URL. Empty means this website's /api route.
VITE_LEADERBOARD_URL=

# PartyKit WebSocket host. Local development defaults to this device on port 1999.
# For production hosting, see .env.production.example and docs/deployment.md.
VITE_PARTYKIT_HOST=

# Server options (set these in the host environment):
# PORT=3001
# DATABASE_PATH=./data/leaderboard.sqlite
# ALLOWED_ORIGIN=https://your-game.example
